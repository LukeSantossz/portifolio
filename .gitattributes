# Keep shell scripts and git hooks LF on every platform so they run under Git Bash and CI.
*.sh         text eol=lf
.githooks/** text eol=lf

# Binary assets: never run line-ending conversion over them. A PDF whose byte
# offsets shift breaks its xref table, and the placeholder resume is plain
# enough that Git guesses "text" without this.
*.pdf  binary
*.png  binary
*.jpg  binary
*.webp binary
*.woff2 binary
