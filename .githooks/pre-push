#!/usr/bin/env bash
# Pre-push: run the R2 Codex cross-provider review from the .standards submodule.
# The submodule's own hook expects the runner at $repo_root/scripts/codex-review.sh;
# in this submodule layout it lives under .standards/, so this wrapper points there
# without modifying the submodule. Advisory by default — see
# .standards/docs/standards/codex_review.md for behavior, env vars, and bypass.
# Activate (one-time, local, not committed): git config core.hooksPath .githooks
set -u

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
runner="$repo_root/.standards/scripts/codex-review.sh"

[ -f "$runner" ] || exit 0

bash "$runner"
exit $?
