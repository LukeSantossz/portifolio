# Web3Forms API Access Key (get a free key at https://web3forms.com)
PUBLIC_WEB3FORMS_KEY=your_web3forms_key_here

# Your hCaptcha sitekey (optional). When set, the contact form shows the hCaptcha widget.
# Also configure the matching hCaptcha secret in your Web3Forms dashboard so Web3Forms
# validates the token. Leave blank to disable.
PUBLIC_HCAPTCHA_SITEKEY=
