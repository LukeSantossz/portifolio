---
import { getCollection } from 'astro:content';
import ProjectCard from '../ui/ProjectCard.astro';
import { site } from '../../data/site.ts';

const entries = await getCollection('projects');
const projects = entries.sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return a.data.order - b.data.order;
});
---

<section
  id="projects"
  class="relative overflow-hidden border-t-2 border-concrete-50 bg-concrete-950 text-concrete-50"
>
  <!-- Decorative analog grain (no semantics, not focusable). -->
  <div class="bt-grain" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto max-w-6xl px-6 pt-16 md:pt-28">
    <div data-projects-anim class="mb-12 flex flex-wrap items-end justify-between gap-4">
      <div class="max-w-2xl">
        <p class="font-mono text-label uppercase tracking-[0.25em] text-concrete-300">
          <span class="text-accent">05 / CASE STUDIES</span>
        </p>
        <h2
          class="mt-3 font-sans text-4xl font-black uppercase leading-[0.95] tracking-[-0.02em] text-concrete-50 md:text-6xl"
        >
          Case studies
        </h2>
        <p class="mt-5 font-sans text-base leading-relaxed text-concrete-300 md:text-lg">
          Not a gallery of screenshots. Each one walks through the problem, the
          constraints, the call I made, and what I would revisit.
        </p>
      </div>
      <a
        href={site.github}
        target="_blank"
        rel="noopener noreferrer"
        class="font-mono text-xs uppercase tracking-wider text-concrete-300 transition-colors hover:text-accent"
      >
        All repositories &rarr;
      </a>
    </div>
  </div>

  <!-- Case-file track. Mobile (< md): a horizontal swipe scroll-snap carousel
       (touch swipe / the controls / arrow keys). Desktop (>= md): the default
       accessible vertical stack. The carousel semantics + controls are applied
       by the script ONLY on mobile; with no JS the track is still reachable
       (a native horizontal scroll on mobile, a plain stack on desktop). -->
  <div class="relative z-10 pb-16 md:pb-28">
    <div
      class="projects-carousel no-scrollbar flex snap-x snap-mandatory gap-6 overflow-x-auto px-6 md:mx-auto md:max-w-6xl md:flex-col md:gap-8 md:snap-none md:overflow-visible"
      data-projects-track
    >
      {
        projects.map((project) => (
          <div
            class="w-[86vw] max-w-2xl shrink-0 snap-center md:w-full md:max-w-none"
            data-project-panel
          >
            <ProjectCard {...project.data} />
          </div>
        ))
      }
    </div>

    <!-- Prev / next + a position readout — revealed by the script on mobile only. -->
    <div
      class="mx-auto mt-8 hidden max-w-6xl items-center justify-center gap-4 px-6"
      data-projects-controls
    >
      <button
        type="button"
        data-projects-prev
        aria-label="Previous case study"
        class="grid h-11 w-11 place-items-center border-2 border-concrete-50 text-concrete-50 transition-colors hover:border-accent hover:text-accent disabled:cursor-not-allowed disabled:opacity-40"
      >
        <span aria-hidden="true" class="text-lg leading-none">&larr;</span>
      </button>
      <p
        class="min-w-[4.5rem] text-center font-mono text-xs uppercase tracking-[0.2em] text-concrete-300"
        data-projects-status
        role="status"
        aria-live="polite"
      >
      </p>
      <button
        type="button"
        data-projects-next
        aria-label="Next case study"
        class="grid h-11 w-11 place-items-center border-2 border-concrete-50 text-concrete-50 transition-colors hover:border-accent hover:text-accent disabled:cursor-not-allowed disabled:opacity-40"
      >
        <span aria-hidden="true" class="text-lg leading-none">&rarr;</span>
      </button>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Heading entrance (any width, motion allowed) — opacity-only, fail-safe.
  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const heading = document.querySelector('#projects [data-projects-anim]');
    if (!heading) return;
    const tween = gsap.from(heading, {
      opacity: 0,
      y: 24,
      duration: 0.6,
      ease: 'power3.out',
      immediateRender: false,
      scrollTrigger: { trigger: heading, start: 'top 85%', once: true },
    });
    return () => {
      if (tween.scrollTrigger) tween.scrollTrigger.kill();
      tween.kill();
      gsap.set(heading, { clearProps: 'all' });
    };
  });

  // Swipe carousel — MOBILE ONLY. Below `md` the track is a horizontal scroll-snap
  // carousel; this wires the prev/next buttons, the readout, and arrow keys, and
  // adds the carousel ARIA. At >= md the section is the default vertical stack, so
  // the controls + carousel semantics are removed. The layout itself is switched
  // by the responsive classes; this only toggles the enhancement.
  const track = document.querySelector<HTMLElement>('#projects [data-projects-track]');
  const controls = document.querySelector<HTMLElement>('#projects [data-projects-controls]');
  const prev = document.querySelector<HTMLButtonElement>('#projects [data-projects-prev]');
  const next = document.querySelector<HTMLButtonElement>('#projects [data-projects-next]');
  const status = document.querySelector<HTMLElement>('#projects [data-projects-status]');

  if (track && controls && prev && next && status) {
    const panels = Array.from(
      track.querySelectorAll<HTMLElement>('[data-project-panel]'),
    );

    if (panels.length > 1) {
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const behavior: ScrollBehavior = prefersReduced ? 'auto' : 'smooth';
      // `md` breakpoint is min-width:768px, so "mobile" is everything below it.
      const mobile = window.matchMedia('(max-width: 767.98px)');

      // The panel whose center is closest to the track's viewport center.
      const currentIndex = () => {
        const center = track.scrollLeft + track.clientWidth / 2;
        let best = 0;
        let bestDist = Infinity;
        panels.forEach((panel, i) => {
          const panelCenter = panel.offsetLeft + panel.offsetWidth / 2;
          const dist = Math.abs(panelCenter - center);
          if (dist < bestDist) {
            bestDist = dist;
            best = i;
          }
        });
        return best;
      };

      const goTo = (i: number) => {
        const clamped = Math.max(0, Math.min(panels.length - 1, i));
        panels[clamped].scrollIntoView({ behavior, inline: 'center', block: 'nearest' });
      };

      const sync = () => {
        const i = currentIndex();
        status.textContent = `${String(i + 1).padStart(2, '0')} / ${String(panels.length).padStart(2, '0')}`;
        prev.disabled = i <= 0;
        next.disabled = i >= panels.length - 1;
        // Deck effect: the centered card sits in focus, its neighbours recede,
        // so swiping reads like dealing through a stack of cards.
        panels.forEach((panel, idx) => panel.classList.toggle('is-active', idx === i));
      };

      // Listeners are wired once; they are inert on desktop (controls hidden, the
      // track does not scroll horizontally, and the track is not focusable there).
      prev.addEventListener('click', () => goTo(currentIndex() - 1));
      next.addEventListener('click', () => goTo(currentIndex() + 1));

      // Arrow keys — only when the track itself is focused, so links/buttons and
      // the <details> summary inside a card keep their own arrow-key behavior.
      track.addEventListener('keydown', (event) => {
        if (event.target !== track) return;
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          goTo(currentIndex() + 1);
        } else if (event.key === 'ArrowLeft') {
          event.preventDefault();
          goTo(currentIndex() - 1);
        }
      });

      let ticking = false;
      track.addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(() => {
              sync();
              ticking = false;
            });
          }
        },
        { passive: true },
      );

      window.addEventListener(
        'resize',
        () => {
          if (mobile.matches) sync();
        },
        { passive: true },
      );

      // Enable the carousel enhancement on mobile; strip it on desktop.
      const applyMode = () => {
        if (mobile.matches) {
          track.classList.add('is-carousel');
          track.setAttribute('role', 'region');
          track.setAttribute('aria-roledescription', 'carousel');
          track.setAttribute('aria-label', 'Case studies carousel');
          track.setAttribute('tabindex', '0');
          panels.forEach((panel, i) => {
            panel.setAttribute('role', 'group');
            panel.setAttribute('aria-roledescription', 'slide');
            panel.setAttribute('aria-label', `${i + 1} of ${panels.length}`);
          });
          controls.classList.remove('hidden');
          controls.classList.add('flex');
          sync();
        } else {
          track.classList.remove('is-carousel');
          for (const attr of ['role', 'aria-roledescription', 'aria-label', 'tabindex']) {
            track.removeAttribute(attr);
          }
          panels.forEach((panel) => {
            panel.classList.remove('is-active');
            panel.removeAttribute('role');
            panel.removeAttribute('aria-roledescription');
            panel.removeAttribute('aria-label');
          });
          controls.classList.add('hidden');
          controls.classList.remove('flex');
        }
      };

      applyMode();
      mobile.addEventListener('change', applyMode);
    }
  }
</script>
