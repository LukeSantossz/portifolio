---
import { site } from '../../data/site.ts';
import SocialLinks from '../ui/SocialLinks.astro';
import Icon from '../ui/Icon.astro';
---

<section id="top" class="relative min-h-screen overflow-hidden">
  <div class="bt-grain" aria-hidden="true"></div>

  <div
    class="relative z-10 mx-auto flex min-h-screen w-full max-w-6xl flex-col justify-center px-6 pb-24 pt-28 md:pt-32"
  >
    <div class="column-rule lg:pl-8">
      <!-- Availability: where, which timezone, how reachable. -->
      <p
        class="font-mono text-label uppercase tracking-[0.25em] text-concrete-300"
      >
        {site.availability}
      </p>

      <h1
        class="mt-7 font-sans text-display font-bold leading-[0.86] tracking-[-0.045em] text-concrete-50"
      >
        {site.name}
      </h1>

      <p
        class="mt-6 font-mono text-base uppercase tracking-[0.35em] text-concrete-50 md:text-lg"
      >
        {site.role}
      </p>

      <p
        class="mt-6 max-w-[54ch] text-lede leading-relaxed text-concrete-300"
      >
        {site.headline}
      </p>

      <div
        class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-4"
      >
        <a href="#work" class="btn btn-primary w-full sm:w-auto">
          Read the work
          <Icon name="arrow-right" size={16} />
        </a>
        <a href={site.cvPath} download class="btn btn-ghost w-full sm:w-auto">
          <Icon name="download" size={16} />
          Résumé
        </a>
        <div class="mt-1 flex items-center gap-4 sm:ml-1 sm:mt-0">
          <SocialLinks labelled />
        </div>
      </div>
    </div>

    <!-- Proof strip: three numbers, each defended by a record in the index. -->
    <dl class="column-rule mt-16 grid max-w-4xl grid-cols-1 gap-px sm:grid-cols-3 lg:pl-8">
      {
        site.heroStats.map((stat) => (
          <div class="border-t border-concrete-700 pt-5 sm:pr-6">
            <dt class="font-mono text-2xl text-concrete-50 md:text-[1.75rem]" data-countup>
              {stat.value}
            </dt>
            <dd class="mt-2 max-w-[34ch] text-sm leading-snug text-concrete-300">{stat.label}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <a
    href="#work"
    aria-label="Scroll to the work"
    class="absolute bottom-7 left-1/2 z-10 hidden -translate-x-1/2 font-mono text-label uppercase tracking-[0.25em] text-concrete-500 transition-colors hover:text-accent md:block"
  >
    Scroll
  </a>
</section>
