---
import { site } from '../../data/site.ts';
import SocialLinks from '../ui/SocialLinks.astro';
import Icon from '../ui/Icon.astro';

// Where each floating badge sits around the photo (md+ only).
// No translate on the left badge: the badge-float animation overrides
// `transform`, so we use top-[42%] instead of top-1/2 + -translate-y-1/2.
const badgePositions = ['-right-3 top-8', '-right-5 bottom-12', '-left-5 top-[42%]'];
---

<section
  id="top"
  class="relative flex min-h-screen flex-col justify-center overflow-hidden"
>
  <!-- Background grid -->
  <div
    class="hero-grid pointer-events-none absolute inset-0 -z-10"
    style="background-image: linear-gradient(to right, color-mix(in srgb, var(--color-paper) 5%, transparent) 1px, transparent 1px), linear-gradient(to bottom, color-mix(in srgb, var(--color-paper) 5%, transparent) 1px, transparent 1px); background-size: 48px 48px; mask-image: radial-gradient(ellipse 70% 55% at 50% 0%, black 30%, transparent 100%); -webkit-mask-image: radial-gradient(ellipse 70% 55% at 50% 0%, black 30%, transparent 100%);"
  >
  </div>
  <!-- Accent glow -->
  <div
    class="pointer-events-none absolute left-1/2 top-0 -z-10 h-[420px] w-[680px] -translate-x-1/2 rounded-full opacity-20 blur-[120px]"
    style="background: radial-gradient(circle, var(--color-accent), transparent 70%);"
  >
  </div>

  <div
    class="mx-auto grid w-full max-w-6xl items-center gap-12 px-6 pb-12 pt-32 md:grid-cols-[1.15fr_1fr] md:pt-36"
  >
    <!-- Left: code-style intro -->
    <div>
      <p class="reveal flex items-center gap-1 font-mono text-sm tracking-wide text-accent">
        <span>Hello, I'm</span>
        <span class="cursor-blink" aria-hidden="true">|</span>
      </p>

      <h1
        class="reveal mt-4 font-mono text-4xl font-bold leading-tight tracking-tight sm:text-5xl md:text-6xl"
      >
        <span class="text-accent-2">const</span>
        <span class="text-ink"> me </span>
        <span class="text-muted">=</span>
        <span class="headline-gradient"> "{site.name}"</span><span class="text-muted">;</span>
      </h1>

      <p class="reveal mt-4 font-mono text-lg text-accent md:text-xl">
        <span class="text-muted">// </span>{site.role}
      </p>

      <p class="reveal mt-6 max-w-xl text-base leading-relaxed text-muted md:text-lg">
        {site.headline}
      </p>

      <div class="reveal mt-8 flex flex-wrap items-center gap-3">
        <a
          href="#projects"
          class="inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-3 text-sm font-semibold text-base transition-transform hover:-translate-y-0.5"
        >
          View projects
          <Icon name="arrow-right" size={18} />
        </a>
        <a
          href={site.cvPath}
          download
          class="inline-flex items-center gap-2 rounded-lg border border-border bg-surface px-5 py-3 text-sm font-semibold text-ink transition-colors hover:border-accent/50"
        >
          <Icon name="download" size={18} />
          Download CV
        </a>
      </div>

      <div class="reveal mt-8 flex flex-wrap items-center gap-5">
        <SocialLinks />
      </div>
    </div>

    <!-- Right: portrait with glow + floating stack badges -->
    <div class="reveal hidden justify-center md:flex" style="--reveal-delay:160ms">
      <div class="relative h-80 w-80 lg:h-[22rem] lg:w-[22rem]">
        <div
          class="profile-glow pointer-events-none absolute left-1/2 top-1/2 h-[120%] w-[120%] -translate-x-1/2 -translate-y-1/2 rounded-full"
          style="background: radial-gradient(circle, color-mix(in srgb, var(--color-accent) 30%, transparent), transparent 70%);"
          aria-hidden="true"
        >
        </div>
        <div
          class="card-lit relative h-full w-full overflow-hidden rounded-full border-4 border-accent/70"
          style="box-shadow: 0 0 44px -8px color-mix(in srgb, var(--color-accent) 60%, transparent);"
        >
          <picture>
            <source srcset="/images/profile.webp" type="image/webp" />
            <img
              src="/images/profile.jpg"
              alt={`${site.name}, ${site.role}`}
              width="800"
              height="800"
              loading="eager"
              decoding="async"
              class="h-full w-full object-cover"
            />
          </picture>
        </div>

        {
          site.heroBadges.map((badge, i) => (
            <div
              class:list={[
                'hero-badge absolute rounded-xl border border-border bg-surface/90 px-3 py-2 shadow-lg backdrop-blur',
                badgePositions[i],
              ]}
              style={`animation-delay:${i * 1.3}s`}
            >
              <div class="flex items-center gap-2">
                <Icon name="code" size={15} class="text-accent" />
                <p class="font-mono text-sm font-bold text-ink">{badge.title}</p>
              </div>
              <p class="mt-0.5 font-mono text-[11px] text-muted">{badge.sub}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Proof strip: three measurable anchors -->
  <dl
    class="reveal mx-auto mt-4 grid w-full max-w-6xl gap-px overflow-hidden rounded-xl border border-border bg-border sm:grid-cols-3"
  >
    {
      site.heroStats.map((stat) => (
        <div class="bg-surface p-4">
          <dt class="font-mono text-lg font-bold text-accent" data-countup>
            {stat.value}
          </dt>
          <dd class="mt-1 text-xs leading-snug text-muted">{stat.label}</dd>
        </div>
      ))
    }
  </dl>

  <!-- Scroll cue -->
  <a
    href="#about"
    aria-label="Scroll to content"
    class="absolute bottom-6 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 text-muted transition-colors hover:text-accent md:flex"
  >
    <span class="flex h-9 w-5 justify-center rounded-full border border-border pt-1.5">
      <span class="scroll-wheel h-2 w-1 rounded-full bg-accent" aria-hidden="true"></span>
    </span>
    <span class="font-mono text-xs tracking-wide">Scroll</span>
  </a>
</section>
