---
import PostCard from '../ui/PostCard.astro';
import { getPosts, readingTime } from '../../data/blog.ts';

// Non-draft posts, newest first. The landing section shows the most recent few;
// the full list lives at /blog/.
const posts = await getPosts();
const recent = posts.slice(0, 4);
---

<section
  id="writing"
  class="relative overflow-hidden border-t-2 border-concrete-50 bg-concrete-950 text-concrete-50"
>
  <!-- Decorative analog grain (no semantics, not focusable). -->
  <div class="bt-grain" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto max-w-5xl px-6 py-24 md:py-28">
    <div data-writing-anim class="mb-12 flex flex-wrap items-end justify-between gap-4">
      <div class="max-w-2xl">
        <p class="font-mono text-label uppercase tracking-[0.25em] text-concrete-300">
          <span class="text-accent">07 / WRITING</span>
        </p>
        <h2
          class="mt-3 font-sans text-4xl font-black uppercase leading-[0.95] tracking-[-0.02em] text-concrete-50 md:text-6xl"
        >
          Writing
        </h2>
        <p class="mt-5 font-sans text-base leading-relaxed text-concrete-300 md:text-lg">
          Short notes on the problems behind the projects — retrieval, forecasting, and the
          engineering calls that don't fit on a résumé.
        </p>
      </div>
      {
        posts.length > 0 && (
          <a
            href="/blog/"
            class="font-mono text-xs uppercase tracking-wider text-concrete-300 transition-colors hover:text-accent"
          >
            View all writing &rarr;
          </a>
        )
      }
    </div>

    {
      recent.length > 0 ? (
        <div class="grid gap-6 sm:grid-cols-2">
          {recent.map((post) => (
            <div data-writing-anim class="h-full">
              <PostCard
                slug={post.id}
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                tags={post.data.tags}
                minutes={readingTime(post.body)}
              />
            </div>
          ))}
        </div>
      ) : (
        <div
          data-writing-anim
          class="border-2 border-dashed border-concrete-700 p-10 text-center"
        >
          <p class="font-mono text-sm uppercase tracking-[0.2em] text-concrete-300">
            New notes are in progress.
          </p>
        </div>
      )
    }
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();

  // Motion allowed: each entrance target fades/rises in as it scrolls into view.
  // immediateRender:false means the hidden state is applied ONLY when the trigger
  // fires — so if ScrollTrigger never runs (or errors), content stays visible.
  // Reduced motion / no-JS never touch it.
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const targets = gsap.utils.toArray<Element>('#writing [data-writing-anim]');

    const tweens = targets.map((el) =>
      gsap.from(el, {
        opacity: 0,
        y: 24,
        duration: 0.6,
        ease: 'power3.out',
        immediateRender: false,
        scrollTrigger: {
          trigger: el,
          start: 'top 85%',
          once: true,
        },
      }),
    );

    return () => {
      tweens.forEach((tween) => {
        if (tween.scrollTrigger) tween.scrollTrigger.kill();
        tween.kill();
      });
      gsap.set(targets, { clearProps: 'all' });
    };
  });
</script>
