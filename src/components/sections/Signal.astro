---
import { site } from '../../data/site.ts';
import { worldMap } from '../../data/world-map.ts';

const { lat, lon, label } = site.location;
// Shared equirectangular projection (must match scripts/generate-world-map.mjs).
const ax = (lon + 180).toFixed(2);
const ay = (90 - lat).toFixed(2);
---

<section
  id="signal"
  class="relative overflow-hidden border-t-2 border-concrete-50 bg-concrete-950 text-concrete-50"
>
  <div class="bt-grain" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto max-w-5xl px-6 py-24 md:py-28">
    <div class="mb-10 max-w-2xl">
      <p class="font-mono text-label uppercase tracking-[0.25em] text-concrete-300">
        <span class="text-accent">08 / SIGNAL</span>
      </p>
      <h2
        class="mt-3 font-sans text-4xl font-black uppercase leading-[0.95] tracking-[-0.02em] text-concrete-50 md:text-6xl"
      >
        Wherever you are
      </h2>
      <p class="mt-5 font-sans text-base leading-relaxed text-concrete-300 md:text-lg">
        Two points on the same map — me in {label}, and you, wherever this reached you. Let's
        close the distance.
      </p>
    </div>

    <!-- Decorative line world map. The meaning is conveyed by the copy above. -->
    <div class="signal-map relative border-2 border-concrete-50 bg-concrete-900 p-2">
      <svg viewBox={worldMap.viewBox} class="block w-full text-concrete-700" aria-hidden="true">
        <path d={worldMap.d} fill="none" stroke="currentColor" stroke-width="0.35" stroke-linejoin="round" />
        <!-- Author point (always rendered). -->
        <g transform={`translate(${ax} ${ay})`}>
          <circle r="2.4" class="signal-pulse" />
          <circle r="1.1" class="signal-point" />
        </g>
        <!-- Visitor point (revealed by the geo script on success). -->
        <g data-visitor-point transform="translate(0 0)" style="display:none">
          <circle r="2.4" class="signal-pulse" />
          <circle r="1.1" class="signal-point" />
        </g>
      </svg>
    </div>

    <p class="mt-3 font-mono text-xs text-concrete-300">
      Your point is placed from your IP (approximate, never stored).
    </p>
  </div>
</section>
