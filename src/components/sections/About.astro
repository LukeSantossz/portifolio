---
import { site } from '../../data/site.ts';

const paragraphs = [
  "I build machine learning for places where being wrong is expensive and a connection is not guaranteed. My bias is toward systems that ship and keep running: ones that measure their own uncertainty, work offline, and are backed by tests and a build pipeline rather than a good demo. If you are reading the case studies below, that is the lens to read them through.",
  "Most of my work has been in and around agriculture, in the interior of São Paulo State in Brazil. As the sole developer on SmartB100, a project funded by FAPESP (the São Paulo state research foundation, one of the main public funders of science in Brazil), I built a question-answering agent that reads technical manuals and reports how confident it is in each answer. My soil-reading app, VisioSoil, placed 3rd out of more than 1,300 entries at FETEPS 2025, a large state science and technology fair, and its research paper was accepted at ICPA 2026, an international precision-agriculture conference.",
  "At Jacto, a Brazilian maker of farm machinery that sells in more than 100 countries, I work where the business meets engineering: automating data migrations and designing a computer-vision system to audit discarded parts. On the data side, I pushed a temperature-forecasting pipeline to about 0.19 degrees Celsius of average error and rebuilt a slow text-cleaning step in Rust to run roughly 42 times faster. I am looking for a full-time, remote AI/ML Engineer role on a distributed team.",
];

const facts = [
  { label: 'Experience', value: '2+ years in applied AI / ML' },
  { label: 'Focus', value: 'LLM agents · RAG · computer vision · NLP · MLOps' },
  { label: 'Open to', value: 'Full-time · Remote · International' },
  { label: 'Email', value: site.email },
];
---

<section id="about" class="border-t border-border/60">
  <div class="mx-auto max-w-5xl px-6 py-24">
    <div data-reveal class="mb-12">
      <span class="font-mono text-sm text-accent">01 / About</span>
      <h2 class="mt-2 text-3xl font-bold tracking-tight md:text-4xl">
        About me
      </h2>
      <div class="accent-rule mt-4"></div>
    </div>

    <div class="grid gap-12 md:grid-cols-[1.5fr_1fr]">
      <div data-reveal="left" class="space-y-5 text-base leading-relaxed text-muted md:text-lg">
        {paragraphs.map((p) => <p>{p}</p>)}
      </div>

      <div data-reveal="right" style="--reveal-delay:120ms" class="space-y-6">
        <figure
          class="card-lit group relative aspect-square w-full overflow-hidden rounded-2xl border border-border transition-colors duration-300 hover:border-accent/40"
        >
          <picture>
            <source srcset="/images/profile.webp" type="image/webp" />
            <img
              src="/images/profile.jpg"
              alt={`${site.name}, ${site.role}`}
              width="800"
              height="800"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          </picture>
        </figure>

        <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-border bg-border">
          {
            facts.map((fact) => (
              <div class="bg-surface p-4">
                <dt class="font-mono text-xs uppercase tracking-wide text-muted">
                  {fact.label}
                </dt>
                <dd class="mt-1 break-words text-sm font-medium text-ink">
                  {fact.value}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>
