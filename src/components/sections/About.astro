---
import Section from '../layout/Section.astro';
import { about } from '../../data/about.ts';
import { sections } from '../../data/sections.ts';
import { site } from '../../data/site.ts';
import { stack } from '../../data/skills.ts';
---

<Section id="about" label={sections.about.label} title={sections.about.title}>
  <div class="mt-14 grid gap-14 md:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] md:gap-16">
    <div data-reveal class="space-y-6">
      {
        about.paragraphs.map((paragraph) => (
          <p class="max-w-[64ch] text-[1.0625rem] leading-relaxed text-concrete-300">{paragraph}</p>
        ))
      }
    </div>

    <div class="space-y-10">
      <!-- Portrait. Grayscale by default so it sits inside the monochrome
           ramp; color on hover, and always color where hover does not exist. -->
      <figure data-reveal class="group aspect-square max-w-[15rem] overflow-hidden border border-concrete-700">
        <picture>
          <source srcset="/images/profile.webp" type="image/webp" />
          <img
            src="/images/profile.jpg"
            alt={`${site.name}, ${site.role}`}
            width="800"
            height="800"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover grayscale transition-[filter] duration-500 group-hover:grayscale-0 [@media(hover:none)]:grayscale-0"
          />
        </picture>
      </figure>

      <dl data-reveal class="space-y-4">
        {
          about.facts.map((fact) => (
            <div class="border-t border-concrete-700 pt-3">
              <dt class="font-mono text-label uppercase tracking-[0.25em] text-concrete-500">
                {fact.label}
              </dt>
              <dd class="mt-1 text-sm text-concrete-50">{fact.value}</dd>
            </div>
          ))
        }
      </dl>

      <div data-reveal>
        <p class="font-mono text-label uppercase tracking-[0.25em] text-concrete-500">
          {about.stackLabel}
        </p>
        <ul class="mt-3 flex flex-wrap gap-x-3 gap-y-1.5">
          {
            stack.map((tool) => (
              <li class="font-mono text-[0.8125rem] text-concrete-300">{tool}</li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</Section>
