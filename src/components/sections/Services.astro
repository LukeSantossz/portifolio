---
import { services } from '../../data/services.ts';
---

<section id="services" class="border-t border-border/60">
  <div class="mx-auto max-w-5xl px-6 py-24">
    <div data-reveal class="mb-12">
      <span class="font-mono text-sm text-accent">03 / What I do</span>
      <h2 class="mt-2 text-3xl font-bold tracking-tight md:text-4xl">
        What I build
      </h2>
      <div class="accent-rule mt-4"></div>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted">
        {services.intro}
      </p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2">
      {
        services.items.map((service, i) => (
          <div
            data-reveal={i % 2 === 0 ? 'left' : 'right'}
            style={`--reveal-delay:${(i % 2) * 90}ms`}
            class="card-lit group relative rounded-xl border border-border bg-surface p-6 transition-all duration-300 hover:-translate-y-1 hover:border-accent/40 hover:shadow-[0_18px_50px_-24px_rgba(70,192,106,0.4)]"
          >
            <span class="font-mono text-sm text-accent-2">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-3 text-lg font-semibold text-ink transition-colors group-hover:text-accent">{service.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{service.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
