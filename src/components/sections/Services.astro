---
/**
 * Self-marketing: the kinds of systems Lucas builds.
 * Each one maps to a real shipped project, so it's positioning, not fluff.
 */
const services = [
  {
    title: 'Computer vision that runs offline',
    body: 'Image models that run on the phone itself, in the field, with no signal and no trip to a server. The soil-reading app below is built this way, for places where connectivity fails and a wrong call is costly.',
  },
  {
    title: 'Forecasting that hedges its bets',
    body: 'Forecasting that does not stake everything on one model: a weighted blend of approaches, anomaly detection, and honest error numbers measured against a public baseline. The temperature pipeline below is the worked example.',
  },
  {
    title: 'LLM agents you can act on',
    body: 'Question-answering and agent systems that report their own uncertainty, so a person knows how far to trust each answer. The agronomy agent below scores its confidence from 0 to 1 and runs with no paid service.',
  },
  {
    title: 'The plumbing that keeps it alive',
    body: 'The work that turns a notebook into a service people can rely on: packaging, automated builds, tests, and the unglamorous infrastructure that keeps a model running long after the demo is over.',
  },
];
---

<section id="services" class="border-t border-border/60">
  <div class="mx-auto max-w-5xl px-6 py-24">
    <div data-reveal class="mb-12">
      <span class="font-mono text-sm text-accent">02 / What I do</span>
      <h2 class="mt-2 text-3xl font-bold tracking-tight md:text-4xl">
        What I build
      </h2>
      <div class="accent-rule mt-4"></div>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted">
        Four things I do well, each one shipped in a real project you can open
        below, not just a line on a slide.
      </p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2">
      {
        services.map((service, i) => (
          <div
            data-reveal={i % 2 === 0 ? 'left' : 'right'}
            style={`--reveal-delay:${(i % 2) * 90}ms`}
            class="card-lit group relative rounded-xl border border-border bg-surface p-6 transition-all duration-300 hover:-translate-y-1 hover:border-accent/40 hover:shadow-[0_18px_50px_-24px_rgba(70,192,106,0.4)]"
          >
            <span class="font-mono text-sm text-accent-2">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-3 text-lg font-semibold text-ink transition-colors group-hover:text-accent">{service.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{service.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
