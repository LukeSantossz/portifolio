---
import Section from '../layout/Section.astro';
import { site } from '../../data/site.ts';
import { sections } from '../../data/sections.ts';
import SocialLinks from '../ui/SocialLinks.astro';
import Icon from '../ui/Icon.astro';

const inputClass =
  'w-full border border-concrete-500 bg-concrete-900 px-4 py-3 font-sans text-sm text-concrete-50 focus:border-accent focus:outline-none';

const labelClass = 'mb-2 block font-mono text-label uppercase tracking-[0.25em] text-concrete-500';

// The form posts to Web3Forms with site.web3formsKey. When PUBLIC_WEB3FORMS_KEY
// is unset that key is empty, so rather than render a form that would fail on
// submit, fall back to an email-only CTA. Warn at build time so an
// unconfigured deploy is noticed.
const formEnabled = site.web3formsKey.trim().length > 0;
if (!formEnabled) {
  console.warn(
    '[contact] PUBLIC_WEB3FORMS_KEY is not set. Rendering the email-only fallback instead of the contact form.',
  );
}

// hCaptcha is optional: render the widget only when a sitekey is configured, so
// an unconfigured deploy renders the exact same form as before.
const captchaEnabled = site.hcaptchaSitekey.trim().length > 0;
---

<Section
  id="contact"
  label={sections.contact.label}
  title={sections.contact.title}
  intro={sections.contact.intro}
>
  <div class="mt-14 grid gap-14 md:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] md:gap-16">
    <div data-reveal class="space-y-8">
      {
        formEnabled && (
          <div>
            <p class="font-mono text-label uppercase tracking-[0.25em] text-concrete-500">
              {sections.contact.emailFallback}
            </p>
            <a
              href={`mailto:${site.email}`}
              class="mt-2 inline-flex items-center gap-2 font-mono text-sm text-concrete-50 transition-colors hover:text-accent"
            >
              <Icon name="mail" size={16} />
              {site.email}
            </a>
          </div>
        )
      }

      <div>
        <p class="font-mono text-label uppercase tracking-[0.25em] text-concrete-500">Elsewhere</p>
        <SocialLinks class="mt-3" />
      </div>
    </div>

    {
      formEnabled ? (
        <form id="contact-form" data-reveal class="space-y-5">
          <input type="hidden" name="access_key" value={site.web3formsKey} />
          <input type="hidden" name="subject" value="New message from your portfolio" />
          {/* Honeypot spam trap (must stay empty) */}
          <input
            type="checkbox"
            name="botcheck"
            class="hidden"
            style="display:none"
            tabindex="-1"
            autocomplete="off"
          />

          <div>
            <label for="name" class={labelClass}>
              Name
            </label>
            <input id="name" type="text" name="name" required class={inputClass} />
          </div>
          <div>
            <label for="email" class={labelClass}>
              Email
            </label>
            <input id="email" type="email" name="email" required class={inputClass} />
          </div>
          <div>
            <label for="message" class={labelClass}>
              Message
            </label>
            <textarea id="message" name="message" required rows="5" class={inputClass} />
          </div>

          {captchaEnabled && <div class="h-captcha" data-sitekey={site.hcaptchaSitekey} />}
          {captchaEnabled && (
            <script is:inline async defer src="https://js.hcaptcha.com/1/api.js" />
          )}

          <button type="submit" class="btn btn-primary w-full disabled:opacity-60 sm:w-auto">
            Send message
            <Icon name="arrow-right" size={16} />
          </button>

          <p class="text-sm leading-relaxed text-concrete-300">{sections.contact.formNote}</p>

          <p id="form-status" class="font-mono text-sm" role="status" />
        </form>
      ) : (
        <div data-reveal class="border border-concrete-700 bg-concrete-900 p-6">
          <p class="text-[0.9375rem] leading-relaxed text-concrete-300">
            The form is not configured on this build. Email is the direct path, and it reaches me
            the same day.
          </p>
          <a href={`mailto:${site.email}`} class="btn btn-primary mt-6">
            <Icon name="mail" size={16} />
            {site.email}
          </a>
        </div>
      )
    }
  </div>

  <!-- Peak-end close: the last line restates the real availability, no urgency. -->
  <p
    data-reveal
    class="mt-16 border-t border-concrete-700 pt-6 font-mono text-label uppercase tracking-[0.25em] text-concrete-300"
  >
    {sections.contact.closing}
  </p>
</Section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');

  if (form && status) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      const data = new FormData(form);

      status.textContent = 'Sending...';
      status.className = 'font-mono text-sm text-concrete-300';
      if (button) button.disabled = true;

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: data,
        });

        // A 5xx often carries an HTML body, so check the status before parsing:
        // otherwise the JSON error surfaces as a misleading "network error".
        if (!response.ok) {
          status.textContent = `The form service returned ${response.status}. Please email me directly.`;
          status.className = 'font-mono text-sm text-alert';
          return;
        }

        const result = await response.json();

        if (result.success) {
          status.textContent = 'Thanks. Your message has been sent.';
          status.className = 'font-mono text-sm text-accent';
          form.reset();
        } else {
          status.textContent = result.message || 'Something went wrong. Please email me directly.';
          status.className = 'font-mono text-sm text-alert';
        }
      } catch {
        status.textContent = 'Network error. Please email me directly instead.';
        status.className = 'font-mono text-sm text-alert';
      } finally {
        if (button) {
          const focusWasLost = document.activeElement === document.body;
          button.disabled = false;
          // Disabling a focused button drops focus to <body>, which would make a
          // keyboard sender tab from the top of the page again.
          if (focusWasLost) button.focus();
        }
      }
    });
  }
</script>
