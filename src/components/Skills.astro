---
import { skillGroups } from '../data/skills.ts';
---

<section id="skills" class="border-t border-border/60">
  <div class="mx-auto max-w-5xl px-6 py-24">
    <div class="mb-12">
      <span class="font-mono text-sm text-accent">02 / Skills</span>
      <h2 class="mt-2 text-3xl font-bold tracking-tight md:text-4xl">
        Skills &amp; stack
      </h2>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        skillGroups.map((group) => (
          <div class="rounded-xl border border-border bg-surface p-6">
            <h3 class="font-mono text-sm uppercase tracking-wide text-accent">
              {group.category}
            </h3>
            <ul class="mt-4 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li class="rounded-md border border-border bg-surface-2 px-3 py-1.5 text-sm text-ink">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
