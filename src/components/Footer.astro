---
import { site } from '../data/site.ts';
import SocialLinks from './SocialLinks.astro';

const year = new Date().getFullYear();
---

<footer class="border-t border-border/60">
  <div
    class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-6 px-6 py-10 sm:flex-row"
  >
    <div class="text-center sm:text-left">
      <p class="font-mono text-sm font-bold text-ink">
        <span class="text-accent">&gt;</span> {site.name}
      </p>
      <p class="mt-1 text-xs text-muted">
        &copy; {year} · Built with Astro &amp; Tailwind CSS
      </p>
    </div>
    <SocialLinks />
  </div>
</footer>
