---
/**
 * Ambient background field.
 *
 * A slow particle field laid out along a lemniscate (the figure-eight), drawn
 * in WebGL behind the page. It reacts to two things a visitor is already doing:
 * the pointer tilts it, and scrolling drifts it. Nothing else moves on its own
 * beyond a slow drift, so it reads as depth rather than as an animation
 * demanding attention.
 *
 * It is decorative, and is built so that being decorative costs nothing:
 *   - three.js loads after the page is idle, never on the critical path, so the
 *     largest paint and the first input are untouched.
 *   - Under `prefers-reduced-motion` it renders one static frame and stops.
 *   - It stops drawing entirely when the tab is hidden or the hero is scrolled
 *     past, because a WebGL loop nobody is looking at is just battery.
 *   - No WebGL, no JS, or a failed import all leave the plain background, which
 *     is what the design already assumes.
 *
 * The canvas sits at `-z-10`, so any section with an opaque background covers
 * it. That is deliberate: the field shows through the hero and the contact
 * block, and stays out from behind the dense reading sections.
 */
---

<canvas
  id="ambient-field"
  aria-hidden="true"
  class="pointer-events-none fixed inset-0 -z-10 h-full w-full"></canvas>

<script>
  const canvas = document.getElementById('ambient-field') as HTMLCanvasElement | null;

  if (canvas) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const start = async () => {
      try {
        const THREE = await import('three');

        const renderer = new THREE.WebGLRenderer({
          canvas,
          antialias: true,
          alpha: true,
          // Keeps the frame readable after compositing, so the field survives a
          // screenshot and can be inspected; the cost is negligible for one
          // small point cloud.
          preserveDrawingBuffer: true,
        });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.75));

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(52, 1, 0.1, 100);
        camera.position.z = 15;

        const group = new THREE.Group();
        scene.add(group);

        // Palette comes from the CSS tokens, so the field follows the theme
        // instead of keeping a second copy of the colours.
        const styles = getComputedStyle(document.documentElement);
        const vivid = new THREE.Color(styles.getPropertyValue('--color-accent-vivid').trim() || '#2f8fff');
        const pale = new THREE.Color(styles.getPropertyValue('--color-concrete-500').trim() || '#8f8b82');

        /** Soft round sprite: without it, points render as hard squares. */
        const sprite = (() => {
          const size = 64;
          const c = document.createElement('canvas');
          c.width = size;
          c.height = size;
          const ctx = c.getContext('2d');

          if (ctx) {
            const g = ctx.createRadialGradient(size / 2, size / 2, 0, size / 2, size / 2, size / 2);
            g.addColorStop(0, 'rgba(255,255,255,1)');
            g.addColorStop(0.35, 'rgba(255,255,255,0.35)');
            g.addColorStop(1, 'rgba(255,255,255,0)');
            ctx.fillStyle = g;
            ctx.fillRect(0, 0, size, size);
          }

          const texture = new THREE.CanvasTexture(c);
          texture.colorSpace = THREE.SRGBColorSpace;
          return texture;
        })();

        // Lemniscate of Gerono, thickened into a 3D band. The shape is the one
        // recognisable thing here; the scatter keeps it from reading as a logo.
        const COUNT = 900;
        const positions = new Float32Array(COUNT * 3);
        const colors = new Float32Array(COUNT * 3);
        const drift = new Float32Array(COUNT);

        for (let i = 0; i < COUNT; i += 1) {
          const t = (i / COUNT) * Math.PI * 2;
          const spread = 0.55 + Math.random() * 1.5;
          const angle = Math.random() * Math.PI * 2;

          positions[i * 3] = Math.cos(t) * 7.5 + Math.cos(angle) * spread;
          positions[i * 3 + 1] = Math.sin(t * 2) * 3.4 + Math.sin(angle) * spread * 0.6;
          positions[i * 3 + 2] = Math.sin(t) * 2.6 + (Math.random() - 0.5) * 2.4;

          // Points near the crossing point carry the accent; the tails fade to
          // the neutral rule colour, so the shape has a centre of gravity.
          const nearCentre = 1 - Math.min(1, Math.abs(Math.cos(t)));
          const colour = pale.clone().lerp(vivid, nearCentre * 0.85);
          colors[i * 3] = colour.r;
          colors[i * 3 + 1] = colour.g;
          colors[i * 3 + 2] = colour.b;

          drift[i] = Math.random() * Math.PI * 2;
        }

        const geometry = new THREE.BufferGeometry();
        geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
        geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));

        const material = new THREE.PointsMaterial({
          size: 0.34,
          map: sprite,
          vertexColors: true,
          transparent: true,
          opacity: 0.5,
          blending: THREE.AdditiveBlending,
          depthWrite: false,
        });

        group.add(new THREE.Points(geometry, material));
        group.rotation.set(0.18, -0.35, 0.06);

        /** Horizontal offset, set by resize: keeps the field off the text. */
        let baseX = 0;

        const resize = () => {
          const width = window.innerWidth;
          const height = window.innerHeight;
          renderer.setSize(width, height, false);
          camera.aspect = width / height;
          camera.updateProjectionMatrix();

          // Push the field into the empty right-hand side on wide screens, so
          // it never sits behind the headline column. Narrow screens have no
          // spare column, so it centres and drops in opacity instead.
          const wide = width >= 1024;
          baseX = wide ? 5.4 : 0;
          material.opacity = wide ? 0.5 : 0.28;
        };

        resize();
        group.position.x = baseX;

        // Draw one frame straight away. The animation loop only runs while the
        // tab is visible, so without this the field would be blank on any load
        // that starts in a background tab and is only looked at later.
        renderer.render(scene, camera);
        canvas.dataset.state = 'ready';
        window.addEventListener('resize', resize, { passive: true });

        if (reduced) {
          renderer.render(scene, camera);
          return;
        }

        // The two things the field reacts to. Both are read in the frame loop
        // rather than acted on directly, so neither listener does layout work.
        let pointerX = 0;
        let pointerY = 0;
        let targetX = 0;
        let targetY = 0;
        let scrollDepth = 0;

        window.addEventListener(
          'pointermove',
          (event) => {
            targetX = (event.clientX / window.innerWidth - 0.5) * 2;
            targetY = (event.clientY / window.innerHeight - 0.5) * 2;
          },
          { passive: true },
        );

        window.addEventListener(
          'scroll',
          () => {
            scrollDepth = window.scrollY / Math.max(1, window.innerHeight);
          },
          { passive: true },
        );

        let frame = 0;
        let clock = 0;

        const tick = () => {
          clock += 0.0018;

          // Ease toward the pointer instead of tracking it, so a fast mouse
          // does not whip the field around.
          pointerX += (targetX - pointerX) * 0.035;
          pointerY += (targetY - pointerY) * 0.035;

          group.rotation.y = -0.35 + clock + pointerX * 0.22;
          group.rotation.x = 0.18 + pointerY * 0.14 + scrollDepth * 0.12;
          group.position.x = baseX;
          group.position.y = scrollDepth * 1.4;

          renderer.render(scene, camera);
          frame = requestAnimationFrame(tick);
        };

        const stop = () => {
          if (frame === 0) return;
          cancelAnimationFrame(frame);
          frame = 0;
          canvas.dataset.state = 'paused';
        };

        const play = () => {
          if (frame === 0 && document.visibilityState === 'visible') {
            canvas.dataset.state = 'running';
            tick();
          }
        };

        document.addEventListener('visibilitychange', () => {
          if (document.visibilityState === 'visible') play();
          else stop();
        });

        // Only draw while the field can actually be seen. Every section below
        // the hero paints an opaque background over it.
        const hero = document.getElementById('top');

        if (hero && 'IntersectionObserver' in window) {
          const watcher = new IntersectionObserver((entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) play();
              else stop();
            }
          });

          watcher.observe(hero);
        }

        play();
      } catch (error) {
        // No WebGL, or the module failed to load. The plain background stands,
        // which is the design's baseline. Say so rather than failing silently.
        canvas.dataset.state = 'unavailable';
        console.warn('[ambient] background field unavailable.', error);
      }
    };

    // After the page is idle: the field is ambience and must never compete with
    // the first paint or the first interaction.
    const schedule = () => {
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(() => void start(), { timeout: 2500 });
      } else {
        window.setTimeout(() => void start(), 900);
      }
    };

    if (document.readyState === 'complete') schedule();
    else window.addEventListener('load', schedule, { once: true });
  }
</script>
