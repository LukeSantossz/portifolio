---
import Icon from '../ui/Icon.astro';
import { site } from '../../data/site.ts';

/** Landing sections, in page order. Blog and the résumé are handled separately. */
const links = [
  { href: '#work', label: 'Work' },
  { href: '#experience', label: 'Experience' },
  { href: '#about', label: 'About' },
  { href: '#contact', label: 'Contact' },
];

const desktopLinkClass =
  'nav-link inline-flex min-h-[24px] items-center font-mono text-label uppercase tracking-[0.25em] text-concrete-300 transition-colors hover:text-concrete-50';
const mobileLinkClass =
  'nav-link block px-3 py-2.5 font-mono text-sm uppercase tracking-[0.25em] text-concrete-300 transition-colors hover:bg-concrete-900 hover:text-concrete-50';
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-40 border-b border-concrete-700 bg-concrete-950/85 backdrop-blur-md"
>
  <!-- Scroll progress: the only always-on indicator, and it reports position. -->
  <div
    id="scroll-progress"
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 bottom-0 h-px"
  >
  </div>

  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
    <a
      href="#top"
      class="inline-flex min-h-[24px] min-w-[24px] items-center font-mono text-sm font-semibold tracking-[0.1em] text-concrete-50"
      aria-label={`${site.initials}, ${site.name}, home`}
    >
      {site.initials}
    </a>

    <ul class="hidden items-center gap-8 md:flex">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class={desktopLinkClass} data-nav-link>
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href="/blog/" class={desktopLinkClass}>Writing</a>
      </li>
      <li>
        <a
          href={site.resumePath}
          download
          class="inline-flex min-h-[24px] items-center border border-concrete-50 px-3 py-1.5 font-mono text-label uppercase tracking-[0.2em] text-concrete-50 transition-colors hover:bg-concrete-50 hover:text-concrete-950"
        >
          Résumé
        </a>
      </li>
    </ul>

    <button
      id="nav-toggle"
      class="grid h-10 w-10 place-items-center text-concrete-50 md:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Icon name="menu" class="nav-icon-open" />
      <Icon name="close" class="nav-icon-close hidden" />
    </button>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-concrete-700 bg-concrete-950 md:hidden">
    <ul class="space-y-1 px-6 py-4">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class={mobileLinkClass} data-nav-link>
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href="/blog/" class={mobileLinkClass} data-nav-link>Writing</a>
      </li>
      <li>
        <a
          href={site.resumePath}
          download
          class="mt-2 block border border-concrete-50 px-3 py-2.5 text-center font-mono text-sm uppercase tracking-[0.2em] text-concrete-50"
          data-nav-link
        >
          Résumé
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  const header = document.getElementById('site-header');

  if (toggle && menu && header) {
    const openIcon = toggle.querySelector('.nav-icon-open');
    const closeIcon = toggle.querySelector('.nav-icon-close');

    const setOpen = (isOpen: boolean) => {
      menu.classList.toggle('hidden', !isOpen);
      openIcon?.classList.toggle('hidden', isOpen);
      closeIcon?.classList.toggle('hidden', !isOpen);
      toggle.setAttribute('aria-expanded', String(isOpen));
      toggle.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
    };

    const close = () => setOpen(false);

    toggle.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));

    menu
      .querySelectorAll('[data-nav-link]')
      .forEach((link) => link.addEventListener('click', close));

    // Escape closes and returns focus to the control that opened the menu.
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || menu.classList.contains('hidden')) return;
      close();
      toggle.focus();
    });

    // A click anywhere outside the header dismisses the menu.
    document.addEventListener('click', (event) => {
      if (menu.classList.contains('hidden')) return;
      if (event.target instanceof Node && header.contains(event.target)) return;
      close();
    });
  }

  // Scroll progress bar. Tracks how far down the page we are.
  const progress = document.getElementById('scroll-progress');

  if (progress) {
    let ticking = false;

    const update = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const ratio = max > 0 ? window.scrollY / max : 0;
      progress.style.setProperty('--p', String(Math.min(1, Math.max(0, ratio))));
      ticking = false;
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  }

  // Scroll-spy. Marks the nav link of the section currently in view.
  const navLinks = Array.from(document.querySelectorAll('[data-nav-link]')).filter((el) =>
    el.getAttribute('href')?.startsWith('#'),
  );

  const linkFor = new Map(navLinks.map((el) => [(el.getAttribute('href') ?? '').slice(1), el]));
  const spySections = [...linkFor.keys()]
    .map((id) => document.getElementById(id))
    .filter((section): section is HTMLElement => section !== null);

  if (spySections.length && 'IntersectionObserver' in window) {
    let current: string | null = null;

    const setCurrent = (id: string) => {
      if (id === current) return;
      current = id;
      navLinks.forEach((el) =>
        el.classList.toggle('is-current', el.getAttribute('href') === `#${id}`),
      );
    };

    const spy = new IntersectionObserver(
      (entries) => {
        // The visible section closest to the top of the viewport wins.
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

        if (visible[0]) setCurrent(visible[0].target.id);
      },
      { rootMargin: '-45% 0px -50% 0px', threshold: 0 },
    );

    spySections.forEach((section) => spy.observe(section));
  }
</script>
