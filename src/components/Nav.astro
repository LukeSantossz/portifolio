---
import Icon from './Icon.astro';
import { site } from '../data/site.ts';

const links = [
  { href: '#about', label: 'About' },
  { href: '#skills', label: 'Skills' },
  { href: '#projects', label: 'Projects' },
  { href: '#experience', label: 'Experience' },
  { href: '#contact', label: 'Contact' },
];
---

<header
  class="fixed inset-x-0 top-0 z-40 border-b border-border/60 bg-base/80 backdrop-blur-md"
>
  <nav class="mx-auto flex h-16 max-w-5xl items-center justify-between px-6">
    <a
      href="#top"
      class="font-mono text-sm font-bold tracking-tight text-ink"
      aria-label={`${site.name} — home`}
    >
      <span class="text-accent">&gt;</span> {site.initials}
    </a>

    <!-- Desktop links -->
    <ul class="hidden items-center gap-7 md:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-sm text-muted transition-colors hover:text-ink"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href={site.cvPath}
          download
          class="rounded-lg border border-accent/40 px-3 py-1.5 text-sm font-medium text-accent transition-colors hover:bg-accent/10"
        >
          Resume
        </a>
      </li>
    </ul>

    <!-- Mobile toggle -->
    <button
      id="nav-toggle"
      class="grid h-10 w-10 place-items-center rounded-lg text-ink md:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Icon name="menu" />
    </button>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden border-t border-border/60 bg-base md:hidden">
    <ul class="space-y-1 px-6 py-4">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="block rounded-lg px-3 py-2 text-base text-muted transition-colors hover:bg-surface hover:text-ink"
              data-nav-link
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href={site.cvPath}
          download
          class="mt-1 block rounded-lg border border-accent/40 px-3 py-2 text-center text-base font-medium text-accent"
          data-nav-link
        >
          Download Resume
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    const close = () => {
      menu.classList.add('hidden');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open menu');
    };

    toggle.addEventListener('click', () => {
      const isOpen = !menu.classList.contains('hidden');
      if (isOpen) {
        close();
      } else {
        menu.classList.remove('hidden');
        toggle.setAttribute('aria-expanded', 'true');
        toggle.setAttribute('aria-label', 'Close menu');
      }
    });

    menu
      .querySelectorAll('[data-nav-link]')
      .forEach((link) => link.addEventListener('click', close));
  }
</script>
