---
import Icon from './Icon.astro';
import { site } from '../../data/site.ts';

interface Props {
  class?: string;
  /** Show the platform name next to the mark. Used where scanning matters. */
  labeled?: boolean;
}

const { class: className = '', labeled = false } = Astro.props;

const links = [
  { href: site.github, label: 'GitHub', icon: 'github' as const },
  { href: site.linkedin, label: 'LinkedIn', icon: 'linkedin' as const },
  { href: `mailto:${site.email}`, label: 'Email', icon: 'mail' as const },
];
---

<div class={`flex items-center gap-2 ${className}`}>
  {
    links.map((link) => (
      <a
        href={link.href}
        target={link.icon === 'mail' ? undefined : '_blank'}
        rel={link.icon === 'mail' ? undefined : 'noopener noreferrer'}
        aria-label={labeled ? undefined : link.label}
        class:list={[
          'flex items-center border border-concrete-500 bg-concrete-900 text-concrete-300 transition-colors hover:border-accent hover:text-accent',
          labeled
            ? 'h-10 gap-2 px-3 font-mono text-label uppercase tracking-[0.15em]'
            : 'h-10 w-10 justify-center',
        ]}
      >
        <Icon name={link.icon} size={18} />
        {labeled && link.label}
      </a>
    ))
  }
</div>
