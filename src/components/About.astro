---
import { site } from '../data/site.ts';

const paragraphs = [
  "I'm an AI Engineer with 2+ years building NLP systems, LLM agents, and production ML pipelines, much of it in and around agriculture, where I study and work in the interior of São Paulo. I like the messy problems: data shot in bad light, manuals nobody has time to read, and critical processes still held together by manual steps.",
  "At Jacto, a global agritech manufacturer, I automated a mission-critical after-sales workflow with a Python layer over the Salesforce and SAP APIs, cutting process resolution time by ~50%. As sole designer of a FAPESP-funded research agent (SB100), I architected a ReAct agent over LangGraph with hybrid retrieval across 500+ documents and built-in hallucination detection. My soil-texture app, VisioSoil, took 3rd of 1,300+ at FETEPS 2025 and was accepted at ICPA 2026 / 17th ConBAP.",
  "I also built an NLP pipeline over 1.6M tweets (0.71 macro F1) with a Rust CLI for preprocessing. I care about work that holds up in production: tests, CI, and commits I won't be embarrassed by later. Seeking a full-time AI/ML Engineer role on a distributed remote team, building production-grade systems at scale.",
];

const facts = [
  { label: 'Experience', value: '2+ years in applied AI / ML' },
  { label: 'Domains', value: 'NLP · LLM Agents · CV · MLOps' },
  { label: 'Open to', value: 'Full-time · Remote · International' },
  { label: 'Email', value: site.email },
];
---

<section id="about" class="border-t border-border/60">
  <div class="mx-auto max-w-5xl px-6 py-24">
    <div class="mb-12">
      <span class="font-mono text-sm text-accent">01 / About</span>
      <h2 class="mt-2 text-3xl font-bold tracking-tight md:text-4xl">
        About me
      </h2>
    </div>

    <div class="grid gap-12 md:grid-cols-[1.5fr_1fr]">
      <div class="space-y-5 text-base leading-relaxed text-muted md:text-lg">
        {paragraphs.map((p) => <p>{p}</p>)}
      </div>

      <div class="space-y-6">
        <!-- Replace with a real photo: put it at public/images/profile.jpg
             and swap this block for <img src="/images/profile.jpg" ... />. -->
        <div
          class="grid aspect-square w-full place-items-center rounded-2xl border border-border bg-surface text-5xl font-bold text-muted"
          aria-hidden="true"
        >
          {site.initials}
        </div>

        <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-border bg-border">
          {
            facts.map((fact) => (
              <div class="bg-surface p-4">
                <dt class="font-mono text-xs uppercase tracking-wide text-muted">
                  {fact.label}
                </dt>
                <dd class="mt-1 break-words text-sm font-medium text-ink">
                  {fact.value}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>
