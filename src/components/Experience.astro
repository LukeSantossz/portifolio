---
import { timeline } from '../data/experience.ts';
---

<section id="experience" class="border-t border-border/60">
  <div class="mx-auto max-w-5xl px-6 py-24">
    <div class="mb-12">
      <span class="font-mono text-sm text-accent">05 / Experience</span>
      <h2 class="mt-2 text-3xl font-bold tracking-tight md:text-4xl">
        Experience &amp; education
      </h2>
    </div>

    <ol class="relative border-l border-border pl-8">
      {
        timeline.map((item) => (
          <li class="relative pb-12 last:pb-0">
            <span
              class={`absolute -left-[37px] top-1 grid h-4 w-4 place-items-center rounded-full border-2 ${
                item.kind === 'work'
                  ? 'border-accent bg-base'
                  : 'border-accent-2 bg-base'
              }`}
            >
              <span
                class={`h-1.5 w-1.5 rounded-full ${
                  item.kind === 'work' ? 'bg-accent' : 'bg-accent-2'
                }`}
              />
            </span>

            <div class="flex flex-wrap items-baseline justify-between gap-x-4">
              <h3 class="text-base font-semibold text-ink">
                {item.role}
                <span class="text-muted"> · {item.org}</span>
              </h3>
              <span class="font-mono text-xs text-muted">{item.period}</span>
            </div>

            <p class="mt-2 text-sm leading-relaxed text-muted">
              {item.description}
            </p>

            {item.highlights && item.highlights.length > 0 && (
              <ul class="mt-3 space-y-1.5">
                {item.highlights.map((h) => (
                  <li class="flex gap-2 text-sm text-muted">
                    <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-accent" />
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>
