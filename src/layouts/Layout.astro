---
import '@fontsource-variable/archivo/wght.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-600.css';
import '../styles/global.css';
import { site } from '../data/site.ts';
import Analytics from '@vercel/analytics/astro';
import AmbientField from '../components/layout/AmbientField.astro';

interface Props {
  title?: string;
  description?: string;
  // Browser-tab label. Defaults to the branded site title; subpages (e.g. blog
  // posts) override it so the tab reads the post title.
  tabTitle?: string;
}

const {
  title = site.seoTitle,
  description = site.seoDescription,
  tabTitle = site.tabTitle,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(site.ogImage, Astro.site);

// Schema.org Person — helps search engines and AI crawlers identify the author
// and surface a rich result. Built from the central site config so it stays in
// sync with the rest of the page.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: Astro.site?.href ?? canonical.href,
  jobTitle: site.role,
  email: `mailto:${site.email}`,
  description: site.seoDescription,
  sameAs: [site.github, site.linkedin],
  knowsAbout: [
    'Retrieval-Augmented Generation',
    'LLM agents',
    'Model evaluation',
    'Machine learning',
    'MLOps',
    'Python',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Branded tab label; og:title below keeps the descriptive sharing title. -->
    <title>{tabTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Browser UI tint follows the visitor's theme (see the light-mode block in global.css). -->
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0e0e0e" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ece9e2" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, ${site.role}`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema).replace(/</g, '\\u003c')} is:inline />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        if (!window.matchMedia('(prefers-reduced-motion: no-preference)').matches) return;
        if (!('IntersectionObserver' in window)) return;
        root.classList.add('reveal-ready');
        window.setTimeout(function () {
          if (root.dataset.revealActive !== '1') root.classList.remove('reveal-ready');
        }, 2000);
      })();
    </script>
  </head>
  <body class="min-h-screen">
    <AmbientField />
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-concrete-50 focus:px-4 focus:py-2 focus:font-mono focus:text-sm focus:text-concrete-950"
    >
      Skip to content
    </a>
    <slot />

    <!-- Vercel Web Analytics: privacy-friendly traffic monitoring on Vercel. -->
    <Analytics />

    <script>
      // One reveal implementation for the whole site (see src/scripts/reveal.ts).
      import { initReveal } from '../scripts/reveal.ts';

      initReveal();
    </script>

    <script>
      // Count-up for the hero proof stats. Their values are not clean numbers
      // ("205 tests", "42x", "0.19°C"), so we animate only the
      // first embedded number, preserving the surrounding text, and skip values
      // with no number. Disabled under reduced-motion / no IntersectionObserver,
      // where the SSR'd final value already shows.
      const countEls = document.querySelectorAll('[data-countup]');
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (countEls.length && !prefersReducedMotion && 'IntersectionObserver' in window) {
        const animateCount = (el: Element) => {
          const full = (el.textContent ?? '').trim();
          const match = full.match(/\d[\d.,]*\d|\d/);
          if (!match) return;

          const raw = match[0];
          const hasComma = raw.includes(',');
          const target = parseFloat(raw.replace(/,/g, ''));
          if (!isFinite(target)) return;

          const dot = raw.indexOf('.');
          const decimals = dot === -1 ? 0 : raw.length - dot - 1;
          const index = match.index ?? 0;
          const before = full.slice(0, index);
          const after = full.slice(index + raw.length);

          const format = (value: number) => {
            const fixed = value.toFixed(decimals);
            if (!hasComma) return fixed;
            const [int, frac] = fixed.split('.');
            const grouped = Number(int).toLocaleString('en-US');
            return frac ? `${grouped}.${frac}` : grouped;
          };

          const duration = 1200;
          let startTs = 0;
          const step = (ts: number) => {
            if (!startTs) startTs = ts;
            const progress = Math.min(1, (ts - startTs) / duration);
            const eased = 1 - Math.pow(1 - progress, 3);
            el.textContent = before + format(target * eased) + after;
            if (progress < 1) {
              requestAnimationFrame(step);
            } else {
              el.textContent = full; // restore the exact original string
            }
          };
          requestAnimationFrame(step);
        };

        const countObserver = new IntersectionObserver(
          (entries, obs) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                animateCount(entry.target);
                obs.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.6 },
        );
        countEls.forEach((el) => countObserver.observe(el));
      }
    </script>
  </body>
</html>
