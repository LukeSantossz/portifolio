---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/layout/Nav.astro';
import Hero from '../components/sections/Hero.astro';
import Work from '../components/sections/Work.astro';
import Experience from '../components/sections/Experience.astro';
import About from '../components/sections/About.astro';
import Contact from '../components/sections/Contact.astro';
import Footer from '../components/layout/Footer.astro';
import MobileActionBar from '../components/layout/MobileActionBar.astro';
---

<Layout>
  <Nav />
  <main id="main">
    <Hero />
    <Work />
    <Experience />
    <About />
    <Contact />
  </main>
  <Footer />
  <!-- Bottom clearance so the fixed mobile action bar never overlaps the footer. -->
  <div class="md:hidden" style="height: calc(4rem + env(safe-area-inset-bottom));"></div>
  <MobileActionBar />
</Layout>
