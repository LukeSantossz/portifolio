---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/layout/Footer.astro';
import SubpageHeader from '../../components/layout/SubpageHeader.astro';
import PostCard from '../../components/ui/PostCard.astro';
import { site } from '../../data/site.ts';
import { getPosts, readingTime } from '../../data/blog.ts';

const posts = await getPosts();

const pageTitle = `Writing · ${site.name}`;
const pageDescription = `Technical notes by ${site.name} on retrieval, forecasting, and applied machine learning.`;
---

<Layout title={pageTitle} description={pageDescription} tabTitle={pageTitle}>
  <SubpageHeader />
  <main id="main" class="min-h-screen bg-concrete-950 text-concrete-50">
    <div class="mx-auto max-w-5xl px-6 py-20 md:py-28">
      <div class="mb-12 max-w-2xl">
        <p class="font-mono text-label uppercase tracking-[0.25em] text-concrete-300">
          <span class="text-accent">WRITING</span>
        </p>
        <h1
          class="mt-3 font-sans text-4xl font-black uppercase leading-[0.95] tracking-[-0.02em] text-concrete-50 md:text-6xl"
        >
          Writing
        </h1>
        <p class="mt-5 font-sans text-base leading-relaxed text-concrete-300 md:text-lg">
          Short notes on the problems behind the projects — retrieval, forecasting, and the
          engineering calls that don't fit on a résumé.
        </p>
      </div>

      {
        posts.length > 0 ? (
          <div class="grid gap-6 sm:grid-cols-2">
            {posts.map((post) => (
              <div class="h-full">
                <PostCard
                  slug={post.id}
                  title={post.data.title}
                  description={post.data.description}
                  pubDate={post.data.pubDate}
                  tags={post.data.tags}
                  minutes={readingTime(post.body)}
                />
              </div>
            ))}
          </div>
        ) : (
          <div class="border-2 border-dashed border-concrete-700 p-10 text-center">
            <p class="font-mono text-sm uppercase tracking-[0.2em] text-concrete-300">
              New notes are in progress.
            </p>
          </div>
        )
      }
    </div>
  </main>
  <Footer />
</Layout>
